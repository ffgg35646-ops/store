# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/digital_marketplace
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Nova Digital
NEXT_PUBLIC_STORE_CURRENCY=USD

# First administrator (run npm run seed:admin once)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_NAME=Store Admin

# Optional online checkout (Stripe). Wallet and manual bank-transfer orders work without Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=false

# Optional browser push notifications (generate a VAPID key pair with web-push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
